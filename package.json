{
  "name": "peage",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "pnpm -r lint && oxlint --type-aware scripts *.config.ts",
    "lint:fix": "pnpm -r lint:fix && oxlint --type-aware --fix scripts *.config.ts",
    "format": "pnpm -r format && oxfmt scripts *.config.ts",
    "format:check": "pnpm -r format:check && oxfmt --check scripts *.config.ts",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p packages/react-native && tsgo --noEmit -p packages/react-native/tsconfig.tests.json && pnpm --filter RNExample typecheck",
    "build": "tsdown",
    "test": "pnpm -r --if-present test",
    "android:internal": "node scripts/publishAndroidInternal.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@peage/protocol": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}

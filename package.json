{
  "name": "peage",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "pnpm -r lint && oxlint --type-aware scripts *.config.ts",
    "lint:fix": "pnpm -r lint:fix && oxlint --type-aware --fix scripts *.config.ts",
    "format": "pnpm -r format && oxfmt scripts .github *.config.ts",
    "format:check": "pnpm -r format:check && oxfmt --check scripts .github *.config.ts",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p packages/react-native && tsgo --noEmit -p packages/react-native/tsconfig.tests.json && pnpm --filter RNExample typecheck",
    "build": "tsdown",
    "test": "pnpm -r --if-present test",
    "android:internal": "node scripts/publishAndroidInternal.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@peage/protocol": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.28.8+sha512.f6988a32046b9a3f78d7d7ee0747926bbe905ff9dff73bf19abb87bd7d1906a2ac90d93f73be32b5f9e14c2899569bcb0c9c5ec8a19e083f5d71bbab6dd9e0b8"
}

{
  "name": "peage",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "pnpm -r lint && oxlint --type-aware scripts *.config.ts",
    "lint:fix": "pnpm -r lint:fix && oxlint --type-aware --fix scripts *.config.ts",
    "format": "pnpm -r format && oxfmt scripts .github *.config.ts",
    "format:check": "pnpm -r format:check && oxfmt --check scripts .github *.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/react-native && tsc --noEmit -p packages/react-native/tsconfig.tests.json && pnpm --filter RNExample typecheck",
    "build": "tsdown",
    "test": "pnpm -r --if-present test",
    "android:internal": "node scripts/publishAndroidInternal.ts",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@changesets/cli": "catalog:",
    "@peage/protocol": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}

{
  "name": "@peage/core",
  "version": "0.4.0",
  "description": "Péage verifiers for iOS App Attest and Android Play Integrity, for writing server adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peage-dev/peage.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run --silent=passed-only"
  },
  "dependencies": {
    "@peage/protocol": "workspace:*",
    "asn1js": "catalog:",
    "cbor2": "catalog:"
  },
  "devDependencies": {
    "@peage/tests": "workspace:*",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  }
}
